# =============================================================================
# CarCloak — Environment / Configuration Reference
# =============================================================================
#
# This is NOT a runtime .env file (the firmware runs on ESP32, not a server).
# It serves as a human-readable quick-reference of every tuneable parameter
# and the value currently compiled into the firmware.
#
# For actual configuration, copy config.example.h → config.h and edit that
# file before uploading to your ESP32 boards.
#
# ─── BLE UUIDs (must match across Master and all Slaves) ────────────────────
SERVICE_UUID=3e942a79-6939-4953-b5ed-1236d4cd3c00
CHARACTERISTIC_CMD=3e942a79-6939-4953-b5ed-1236d4cd3b00
CHARACTERISTIC_ACK=3e942a79-6939-4953-b5ed-1236d4cd3a00

# ─── BLE Device Names ──────────────────────────────────────────────────────
MASTER_DEVICE_NAME=Master Unit
SLAVE_DEVICE_NAME=Slave Unit

# ─── Master Unit — GPIO Pins ───────────────────────────────────────────────
# BUTTON1_PIN: toggle relay state (cloak on/off)
# BUTTON2_PIN: toggle display sleep mode
BUTTON1_PIN=0
BUTTON2_PIN=35

# ─── Slave Unit — GPIO Pins ────────────────────────────────────────────────
# RELAY_PIN1 / RELAY_PIN2: GPIOs driving relay transistor bases
# LED_PIN: status LED (NeoPixel or standard)
RELAY_PIN1=2
RELAY_PIN2=3
LED_PIN=8

# ─── Slave Unit — LED Configuration ────────────────────────────────────────
NUM_LEDS=1
# true = NeoPixel (WS2812) RGB LED, false = plain on/off LED
USE_NEOPIXEL=false

# ─── EEPROM ────────────────────────────────────────────────────────────────
EEPROM_SIZE=1
STATE_ADDR=0
RELAY_STATE_ADDR=0

# ─── Timing / Behaviour ────────────────────────────────────────────────────
BLE_SCAN_DURATION_SEC=10
PERIODIC_CMD_INTERVAL_MS=10000
STATUS_UPDATE_INTERVAL_MS=5000
BUTTON_DEBOUNCE_MS=500
SCAN_RETRY_DELAY_MS=5000

# ─── Number of Slave Units ─────────────────────────────────────────────────
NUM_SLAVES=2

# ─── Serial / Debug ────────────────────────────────────────────────────────
SERIAL_BAUD_RATE=115200

# ─── Display (Master) ──────────────────────────────────────────────────────
# TFT_eSPI rotation value (0–3). 3 = landscape, USB on the right.
TFT_ROTATION=3

# ─── Arduino Board Selection ───────────────────────────────────────────────
# Master: ESP32-LoRa32-OLED (TTGO T-Display)
# Slaves: ESP32C3 DevModule
